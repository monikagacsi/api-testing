  "item": [
    {
      "name": "Pet",
      "item": [
        {
          "name": "PET-001: Add a New Pet to the Store",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 109283,\n  \"category\": { \"id\": 1, \"name\": \"Dogs\" },\n  \"name\": \"Buddy\",\n  \"photoUrls\": [\"https://images.example.com/buddy.jpg\"],\n  \"tags\": [{ \"id\": 1, \"name\": \"friendly\" }],\n  \"status\": \"available\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": ["{{baseUrl}}"],
              "path": ["pet"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Pet name is Buddy\", function () {",
                  "    pm.expect(jsonData.name).to.eql(\"Buddy\");",
                  "});",
                  "pm.environment.set(\"petId\", jsonData.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PET-002: Find Pet by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet/{{petId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pet", "{{petId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Verify correct pet ID returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get(\"petId\"));",
                  "});"
                ]
              }
            }
          ]
        },
