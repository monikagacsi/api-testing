    {
      "name": "BOOKING-009: [Security] Update Booking Without Auth Token",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Hacker\",\n  \"lastname\": \"Unauthorized\",\n  \"totalprice\": 999,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-06-01\",\n    \"checkout\": \"2026-06-05\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/booking/1",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "BOOKING-010: [Boundary] Create Booking with Extreme Numeric Price",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Boundary\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 999999999,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-01-01\",\n    \"checkout\": \"2026-12-31\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": ["{{baseUrl}}"],
          "path": ["booking"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code handles high numeric boundary\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 500]);",
              "});"
            ]
          }
        }
      ]
    },
