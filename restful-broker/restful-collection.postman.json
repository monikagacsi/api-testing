      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Cookie", "value": "token={{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created/Deleted\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "BOOKING-008: [Negative] Get Non-Existent Booking ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/99999999",
